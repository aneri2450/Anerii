<section class="stories-section">
  <div class="stories-container">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#collections' }}" class="story-item">
        <div class="story-avatar-wrap">
          {%- if block.settings.image != blank -%}
            <img class="story-img" src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.title }}" width="74" height="74" loading="lazy">
          {%- else -%}
            <img class="story-img" src="{{ 'finalised_logo.jpg-removebg.png' | asset_url }}" alt="{{ block.settings.title }}" width="74" height="74" loading="lazy">
          {%- endif -%}
        </div>
        <span class="story-label">{{ block.settings.title }}</span>
      </a>
    {%- else -%}
      <a href="#collections" class="story-item active" onclick="if(typeof filterCategory==='function') filterCategory('all', true)">
        <div class="story-avatar-wrap">
          <img class="story-img" src="https://cdn.shopify.com/s/files/1/1013/9628/3701/files/aneri008-1.jpg?v=1787815008&width=160" alt="All Collections" width="74" height="74" loading="lazy" decoding="async">
        </div>
        <span class="story-label">All Pieces</span>
      </a>
      <a href="#collections" class="story-item" onclick="if(typeof filterCategory==='function') filterCategory('co-ords', true)">
        <div class="story-avatar-wrap">
          <img class="story-img" src="https://cdn.shopify.com/s/files/1/1013/9628/3701/files/PUN4247.jpg?v=1787840184&width=160" alt="Co-ord Sets" width="74" height="74" loading="lazy" decoding="async">
        </div>
        <span class="story-label">Co-ords</span>
      </a>
      <a href="#collections" class="story-item" onclick="if(typeof filterCategory==='function') filterCategory('kurta-sets', true)">
        <div class="story-avatar-wrap">
          <img class="story-img" src="https://cdn.shopify.com/s/files/1/1013/9628/3701/files/PUN4197.jpg?v=1787836695&width=160" alt="Kurta Sets" width="74" height="74" loading="lazy" decoding="async">
        </div>
        <span class="story-label">Kurta Sets</span>
      </a>
      <a href="#collections" class="story-item" onclick="if(typeof filterCategory==='function') filterCategory('kurtis', true)">
        <div class="story-avatar-wrap">
          <img class="story-img" src="https://cdn.shopify.com/s/files/1/1013/9628/3701/files/aneri009_noor-e-neel-backless-short-kurti.jpg?v=1787809941&width=160" alt="Kurtis & Tops" width="74" height="74" loading="lazy" decoding="async">
        </div>
        <span class="story-label">Kurtis & Tops</span>
      </a>
      <a href="#collections" class="story-item" onclick="if(typeof filterCategory==='function') filterCategory('noor-e-neel', true)">
        <div class="story-avatar-wrap">
          <img class="story-img" src="https://cdn.shopify.com/s/files/1/1013/9628/3701/files/aneri007-3.jpg?v=1787815743&width=160" alt="Noor-e-Neel Edit" width="74" height="74" loading="lazy" decoding="async">
        </div>
        <span class="story-label">Noor-e-Neel</span>
      </a>
      <a href="#collections" class="story-item" onclick="if(typeof filterCategory==='function') filterCategory('rangrez', true)">
        <div class="story-avatar-wrap">
          <img class="story-img" src="https://cdn.shopify.com/s/files/1/1013/9628/3701/files/PUN4197.jpg?v=1787836695&width=160" alt="Rangrez Edit" width="74" height="74" loading="lazy" decoding="async">
        </div>
        <span class="story-label">Rangrez</span>
      </a>
      <a href="#collections" class="story-item" onclick="if(typeof filterCategory==='function') filterCategory('gulnaaz', true)">
        <div class="story-avatar-wrap">
          <img class="story-img" src="https://cdn.shopify.com/s/files/1/1013/9628/3701/files/aneri-new-floral-3.jpg?v=1787817296&width=160" alt="Gulnaaz Edit" width="74" height="74" loading="lazy" decoding="async">
        </div>
        <span class="story-label">Gulnaaz</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Story Circles",
  "blocks": [
    {
      "type": "story",
      "name": "Story Highlight",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Avatar Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Label",
          "default": "Co-ord Sets"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story Circles"
    }
  ]
}
{% endschema %}
