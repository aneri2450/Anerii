<div class="product-page-wrapper">
  <div class="product-page-layout">
    
    <!-- Left: Product Media Gallery (Touch Swipe / Finger Scroll on Mobile, Hover Zoom on Desktop) -->
    <div class="product-gallery-side">
      <div class="product-media-carousel-wrapper">
        <div id="zoomContainer" class="product-zoom-container">
          
          <div class="product-main-slider-track" id="productSliderTrack">
            {%- for media in product.media -%}
              <div class="product-slide" data-index="{{ forloop.index0 }}">
                <img class="product-zoom-image"
                     src="{{ media | image_url: width: 1200 }}" 
                     alt="{{ product.title | escape }} - Photo {{ forloop.index }}" 
                     loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                     {% if forloop.first %}fetchpriority="high"{% endif %}
                     width="800" 
                     height="1066">
              </div>
            {%- else -%}
              {%- if product.featured_media != blank -%}
                <div class="product-slide" data-index="0">
                  <img class="product-zoom-image"
                       src="{{ product.featured_media | image_url: width: 1200 }}" 
                       alt="{{ product.title | escape }}" 
                       loading="eager"
                       fetchpriority="high"
                       width="800" 
                       height="1066">
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <!-- Mobile Pagination Pill / Badge -->
          {%- if product.media.size > 1 -%}
            <div class="gallery-badge-counter" id="galleryBadgeCounter">
              <span id="currentSlideNum">1</span> / {{ product.media.size }}
            </div>
            
            <!-- Navigation Arrow Buttons -->
            <button type="button" class="gallery-arrow-btn prev" aria-label="Previous Image" onclick="slideProductGallery(-1)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" class="gallery-arrow-btn next" aria-label="Next Image" onclick="slideProductGallery(1)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          {%- endif -%}
        </div>
      </div>

      <!-- Thumbnail Strip -->
      {%- if product.media.size > 1 -%}
        <div class="gallery-thumbs-row" id="galleryThumbsRow">
          {%- for media in product.media -%}
            <img class="thumb-img{% if forloop.first %} active{% endif %}" 
                 src="{{ media | image_url: width: 160, height: 210, crop: 'center' }}" 
                 alt="{{ product.title }}" 
                 data-index="{{ forloop.index0 }}"
                 loading="lazy"
                 onclick="goToProductSlide({{ forloop.index0 }})">
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Right: Product Details (Exact Pehrin Design Match) -->
    <div class="product-details-content">
      
      <!-- Product Title -->
      <h1 class="pehrin-product-title">{{ product.title }}</h1>
      
      <!-- Price & Sale Pill -->
      <div class="pehrin-price-row">
        {%- if product.compare_at_price > product.price -%}
          <span class="pehrin-price-original">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="pehrin-price-current">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="pehrin-sale-pill">Sale</span>
        {%- endif -%}
      </div>
      <div class="pehrin-tax-note">Taxes included.</div>

      <!-- Purchase Form -->
      {%- form 'product', product, id: 'product-form', class: 'pehrin-product-form' -%}
        
        <!-- Size Selector -->
        {%- if product.has_only_default_variant == false -%}
          <div style="margin-top: 10px;">
            <div class="pehrin-size-row-header">
              <span class="pehrin-size-label">Size</span>
              <span class="pehrin-size-chart-btn" onclick="alert('Anerii Size Chart (Inches):\n\nXS: Bust 34 | Waist 30 | Hip 36\nS: Bust 36 | Waist 32 | Hip 38\nM: Bust 38 | Waist 34 | Hip 40\nL: Bust 40 | Waist 36 | Hip 42\nXL: Bust 42 | Waist 38 | Hip 44\nXXL: Bust 44 | Waist 40 | Hip 46\n\nFabric: 100% 60×60 Combed Cotton')">
                📐 Size Chart
              </span>
            </div>
            
            <div class="pehrin-size-pills">
              {%- for variant in product.variants -%}
                <label style="margin: 0; cursor: pointer;">
                  <input type="radio" name="id" value="{{ variant.id }}" {% if forloop.first %}checked{% endif %} style="display:none;" onchange="updateSelectedSizePill(this)">
                  <span class="pehrin-size-pill{% if forloop.first %} selected{% endif %}">
                    {{ variant.title }}
                  </span>
                </label>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endif -%}

        <!-- Quantity Stepper -->
        <div class="pehrin-qty-box">
          <div class="pehrin-qty-label">Quantity</div>
          <div class="pehrin-qty-stepper">
            <button type="button" class="pehrin-qty-btn" onclick="adjustProductQty(-1)">−</button>
            <span id="productQtyDisplay" class="pehrin-qty-val">1</span>
            <input type="hidden" name="quantity" id="productQtyInput" value="1">
            <button type="button" class="pehrin-qty-btn" onclick="adjustProductQty(1)">+</button>
          </div>
        </div>

        <!-- Buttons: Add to cart & Buy it now -->
        <div style="margin-top: 16px;">
          <button type="submit" name="add" class="pehrin-btn-add">
            Add to cart
          </button>
          <button type="submit" name="checkout" class="pehrin-btn-buy">
            Buy it now
          </button>
        </div>

      {%- endform -%}

      <!-- Description & Fabric Details -->
      <div class="pehrin-desc-text" style="border-top: 1px solid var(--border-light); padding-top: 16px; margin-top: 12px;">
        {{ product.description }}
      </div>

      <!-- Share Button -->
      <button type="button" class="pehrin-share-btn" onclick="shareCurrentProduct('{{ product.title | escape }}', '{{ shop.url }}{{ product.url }}')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <polyline points="16 6 12 2 8 6"></polyline>
          <line x1="12" y1="2" x2="12" y2="15"></line>
        </svg>
        Share
      </button>

      <!-- Trust Badges -->
      <div style="border-top: 1px solid var(--border-light); padding-top: 16px; font-size: 0.86rem; color: var(--color-text-muted); display: flex; flex-direction: column; gap: 6px;">
        <div>✓ 100% Breathable 60×60 Pure Cotton</div>
        <div>✓ Free Express Shipping on orders above Rs. 999</div>
        <div>✓ Hassle-free 7-day doorstep size exchange</div>
      </div>

    </div>

  </div>
</div>

<script>
  // Slide to Specific Image Index
  function goToProductSlide(index) {
    const track = document.getElementById('productSliderTrack');
    if (!track) return;
    const slides = track.querySelectorAll('.product-slide');
    if (index < 0 || index >= slides.length) return;
    
    const targetSlide = slides[index];
    if (targetSlide) {
      track.scrollTo({
        left: targetSlide.offsetLeft,
        behavior: 'smooth'
      });
    }
    updateActiveThumbnail(index);
  }

  // Next / Previous Image Arrow Navigation
  function slideProductGallery(direction) {
    const track = document.getElementById('productSliderTrack');
    if (!track) return;
    const slideWidth = track.offsetWidth || 1;
    const currentIndex = Math.round(track.scrollLeft / slideWidth);
    const slides = track.querySelectorAll('.product-slide');
    let nextIndex = currentIndex + direction;
    if (nextIndex < 0) nextIndex = 0;
    if (nextIndex >= slides.length) nextIndex = slides.length - 1;
    goToProductSlide(nextIndex);
  }

  // Update Thumbnail Active Highlight & Badge Counter
  function updateActiveThumbnail(index) {
    const thumbs = document.querySelectorAll('#galleryThumbsRow .thumb-img');
    thumbs.forEach((t, i) => {
      if (i === index) {
        t.classList.add('active');
        t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      } else {
        t.classList.remove('active');
      }
    });
    const counterEl = document.getElementById('currentSlideNum');
    if (counterEl) {
      counterEl.textContent = (index + 1);
    }
  }

  // Mobile Touch Finger Swiping & Scroll Listener
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('productSliderTrack');
    if (track) {
      let scrollTimer;
      track.addEventListener('scroll', () => {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          const slideWidth = track.offsetWidth || 1;
          const index = Math.round(track.scrollLeft / slideWidth);
          updateActiveThumbnail(index);
        }, 60);
      }, { passive: true });

      // Touch gesture support (swipe left/right)
      let touchStartX = 0;
      let touchEndX = 0;
      let isSwiping = false;

      track.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        isSwiping = true;
      }, { passive: true });

      track.addEventListener('touchend', (e) => {
        if (!isSwiping) return;
        touchEndX = e.changedTouches[0].screenX;
        const diffX = touchStartX - touchEndX;
        if (Math.abs(diffX) > 40) {
          if (diffX > 0) {
            slideProductGallery(1); // Swipe left -> next image
          } else {
            slideProductGallery(-1); // Swipe right -> prev image
          }
        }
        isSwiping = false;
      }, { passive: true });
    }
  });

  // Size Selector Toggle
  function updateSelectedSizePill(radioInput) {
    document.querySelectorAll('.pehrin-size-pills .pehrin-size-pill').forEach(p => p.classList.remove('selected'));
    const span = radioInput.nextElementSibling;
    if (span) span.classList.add('selected');
  }

  // Quantity Stepper
  function adjustProductQty(delta) {
    const qtyInput = document.getElementById('productQtyInput');
    const qtyDisplay = document.getElementById('productQtyDisplay');
    let val = parseInt(qtyInput.value, 10) || 1;
    val += delta;
    if (val < 1) val = 1;
    qtyInput.value = val;
    qtyDisplay.textContent = val;
  }

  // Share Product Link
  function shareCurrentProduct(title, url) {
    if (navigator.share) {
      navigator.share({
        title: title,
        url: url
      }).catch(() => {});
    } else {
      navigator.clipboard.writeText(url).then(() => {
        alert('Product link copied to clipboard! 📋');
      });
    }
  }
</script>

{% schema %}
{
  "name": "Product Details"
}
{% endschema %}
