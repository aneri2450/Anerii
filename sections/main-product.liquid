<div class="product-page-wrapper">
  <div class="product-page-layout">
    
    <!-- Left: Product Media Gallery (Touch Swipe / Finger Scroll on Mobile, Hover Zoom on Desktop) -->
    <div class="product-gallery-side">
      <div class="product-media-carousel-wrapper">
        <div id="zoomContainer" class="product-zoom-container">
          
          <div class="product-main-slider-track" id="productSliderTrack">
            {%- for media in product.media -%}
              <div class="product-slide" data-index="{{ forloop.index0 }}" onclick="handleSlideClick({{ forloop.index0 }})">
                <img class="product-zoom-image"
                     src="{{ media | image_url: width: 1200 }}" 
                     alt="{{ product.title | escape }} - Photo {{ forloop.index }}" 
                     loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                     {% if forloop.first %}fetchpriority="high"{% endif %}
                     width="800" 
                     height="1066">
              </div>
            {%- else -%}
              {%- if product.featured_media != blank -%}
                <div class="product-slide" data-index="0" onclick="handleSlideClick(0)">
                  <img class="product-zoom-image"
                       src="{{ product.featured_media | image_url: width: 1200 }}" 
                       alt="{{ product.title | escape }}" 
                       loading="eager"
                       fetchpriority="high"
                       width="800" 
                       height="1066">
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <!-- Floating Zoom Trigger Button -->
          <button type="button" class="gallery-zoom-trigger-btn" aria-label="Zoom Photo" onclick="openFullscreenZoom(); event.stopPropagation();" title="Tap to Zoom">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>

          <!-- Mobile Pagination Pill / Badge -->
          {%- if product.media.size > 1 -%}
            <div class="gallery-badge-counter" id="galleryBadgeCounter">
              <span id="currentSlideNum">1</span> / {{ product.media.size }}
            </div>
            
            <!-- Navigation Arrow Buttons -->
            <button type="button" class="gallery-arrow-btn prev" aria-label="Previous Image" onclick="slideProductGallery(-1)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" class="gallery-arrow-btn next" aria-label="Next Image" onclick="slideProductGallery(1)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          {%- endif -%}
        </div>
      </div>

      <!-- Thumbnail Strip -->
      {%- if product.media.size > 1 -%}
        <div class="gallery-thumbs-row" id="galleryThumbsRow">
          {%- for media in product.media -%}
            <img class="thumb-img{% if forloop.first %} active{% endif %}" 
                 src="{{ media | image_url: width: 160, height: 210, crop: 'center' }}" 
                 alt="{{ product.title }}" 
                 data-index="{{ forloop.index0 }}"
                 loading="lazy"
                 onclick="goToProductSlide({{ forloop.index0 }})">
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Right: Product Details (Exact Pehrin Design Match) -->
    <div class="product-details-content">
      
      <!-- Product Title -->
      <h1 class="pehrin-product-title">{{ product.title }}</h1>
      
      <!-- Price & Sale Pill -->
      <div class="pehrin-price-row">
        {%- if product.compare_at_price > product.price -%}
          <span class="pehrin-price-original">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="pehrin-price-current">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="pehrin-sale-pill">Sale</span>
        {%- endif -%}
      </div>
      <div class="pehrin-tax-note">Taxes included.</div>

      <!-- Purchase Form -->
      {%- form 'product', product, id: 'product-form', class: 'pehrin-product-form' -%}
        
        <!-- Size Selector -->
        {%- if product.has_only_default_variant == false -%}
          <div style="margin-top: 10px;">
            <div class="pehrin-size-row-header">
              <span class="pehrin-size-label">Size</span>
              <span class="pehrin-size-chart-btn" onclick="alert('Anerii Size Chart (Inches):\n\nXS: Bust 34 | Waist 30 | Hip 36\nS: Bust 36 | Waist 32 | Hip 38\nM: Bust 38 | Waist 34 | Hip 40\nL: Bust 40 | Waist 36 | Hip 42\nXL: Bust 42 | Waist 38 | Hip 44\nXXL: Bust 44 | Waist 40 | Hip 46\n\nFabric: 100% 60×60 Combed Cotton')">
                📐 Size Chart
              </span>
            </div>
            
            <div class="pehrin-size-pills">
              {%- for variant in product.variants -%}
                <label style="margin: 0; cursor: pointer;">
                  <input type="radio" name="id" value="{{ variant.id }}" {% if forloop.first %}checked{% endif %} style="display:none;" onchange="updateSelectedSizePill(this)">
                  <span class="pehrin-size-pill{% if forloop.first %} selected{% endif %}">
                    {{ variant.title }}
                  </span>
                </label>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endif -%}

        <!-- Quantity Stepper -->
        <div class="pehrin-qty-box">
          <div class="pehrin-qty-label">Quantity</div>
          <div class="pehrin-qty-stepper">
            <button type="button" class="pehrin-qty-btn" onclick="adjustProductQty(-1)">−</button>
            <span id="productQtyDisplay" class="pehrin-qty-val">1</span>
            <input type="hidden" name="quantity" id="productQtyInput" value="1">
            <button type="button" class="pehrin-qty-btn" onclick="adjustProductQty(1)">+</button>
          </div>
        </div>

        <!-- Buttons: Add to cart & Buy it now -->
        <div style="margin-top: 16px;">
          <button type="submit" name="add" class="pehrin-btn-add">
            Add to cart
          </button>
          <button type="submit" name="checkout" class="pehrin-btn-buy">
            Buy it now
          </button>
        </div>

      {%- endform -%}

      <!-- Description & Fabric Details -->
      <div class="pehrin-desc-text" style="border-top: 1px solid var(--border-light); padding-top: 16px; margin-top: 12px;">
        {{ product.description }}
      </div>

      <!-- Share Button -->
      <button type="button" class="pehrin-share-btn" onclick="shareCurrentProduct('{{ product.title | escape }}', '{{ shop.url }}{{ product.url }}')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <polyline points="16 6 12 2 8 6"></polyline>
          <line x1="12" y1="2" x2="12" y2="15"></line>
        </svg>
        Share
      </button>

      <!-- Trust Badges -->
      <div style="border-top: 1px solid var(--border-light); padding-top: 16px; font-size: 0.86rem; color: var(--color-text-muted); display: flex; flex-direction: column; gap: 6px;">
        <div>✓ 100% Breathable 60×60 Pure Cotton</div>
        <div>✓ Free Express Shipping on orders above Rs. 999</div>
        <div>✓ Hassle-free 7-day doorstep size exchange</div>
      </div>

    </div>

  </div>
</div>

<!-- Fullscreen HD Image Zoom Modal (Mobile Pinch-Zoom, Pan & Double-Tap) -->
<div id="productZoomModal" class="product-zoom-modal" role="dialog" aria-modal="true" aria-label="Product Image Zoom">
  <div class="zoom-modal-header">
    <span class="zoom-modal-counter" id="modalZoomCounter">1 / {{ product.media.size | default: 1 }}</span>
    <button type="button" class="zoom-modal-close" onclick="closeFullscreenZoom()" aria-label="Close Zoom View">✕</button>
  </div>
  
  <div class="zoom-modal-body" id="zoomModalBody">
    <div class="zoom-modal-viewport" id="zoomModalViewport">
      <img id="zoomModalImg" class="zoom-modal-img" src="" alt="{{ product.title | escape }}">
    </div>
  </div>
  
  <div class="zoom-modal-footer">
    <button type="button" class="zoom-nav-btn prev" onclick="slideModalZoom(-1)" aria-label="Previous Image">❮</button>
    <span class="zoom-hint-text">🔍 Pinch or Double-Tap to Zoom</span>
    <button type="button" class="zoom-nav-btn next" onclick="slideModalZoom(1)" aria-label="Next Image">❯</button>
  </div>
</div>

<script>
  window.PRODUCT_MEDIA_ITEMS = [
    {%- for media in product.media -%}
      "{{ media | image_url: width: 1800 }}"{% unless forloop.last %},{% endunless %}
    {%- else -%}
      {%- if product.featured_media != blank -%}
        "{{ product.featured_media | image_url: width: 1800 }}"
      {%- endif -%}
    {%- endfor -%}
  ];

  let currentModalIndex = 0;
  let modalScale = 1;
  let modalPanX = 0;
  let modalPanY = 0;

  // Click on slide photo
  let lastSlideClickTime = 0;
  function handleSlideClick(index) {
    // Open HD Fullscreen Zoom on tap/click
    openFullscreenZoom(index);
  }

  // Open Fullscreen Zoom Modal
  function openFullscreenZoom(index) {
    const modal = document.getElementById('productZoomModal');
    const modalImg = document.getElementById('zoomModalImg');
    if (!modal || !modalImg) return;

    if (typeof index !== 'number') {
      const track = document.getElementById('productSliderTrack');
      const slideWidth = (track && track.offsetWidth) || 1;
      index = track ? Math.round(track.scrollLeft / slideWidth) : 0;
    }

    if (window.PRODUCT_MEDIA_ITEMS && window.PRODUCT_MEDIA_ITEMS.length > 0) {
      if (index < 0) index = 0;
      if (index >= window.PRODUCT_MEDIA_ITEMS.length) index = window.PRODUCT_MEDIA_ITEMS.length - 1;
      currentModalIndex = index;
      modalImg.src = window.PRODUCT_MEDIA_ITEMS[currentModalIndex];
    }

    resetModalTransform();
    updateModalCounter();
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  // Close Fullscreen Zoom Modal
  function closeFullscreenZoom() {
    const modal = document.getElementById('productZoomModal');
    if (modal) modal.classList.remove('active');
    document.body.style.overflow = '';
    resetModalTransform();
  }

  // Reset Modal Transform
  function resetModalTransform() {
    modalScale = 1;
    modalPanX = 0;
    modalPanY = 0;
    const modalImg = document.getElementById('zoomModalImg');
    if (modalImg) {
      modalImg.style.transform = 'translate3d(0px, 0px, 0px) scale(1)';
    }
  }

  // Update Modal Counter
  function updateModalCounter() {
    const counterEl = document.getElementById('modalZoomCounter');
    const total = (window.PRODUCT_MEDIA_ITEMS && window.PRODUCT_MEDIA_ITEMS.length) || 1;
    if (counterEl) {
      counterEl.textContent = `${currentModalIndex + 1} / ${total}`;
    }
  }

  // Slide between images inside Modal
  function slideModalZoom(direction) {
    if (!window.PRODUCT_MEDIA_ITEMS || window.PRODUCT_MEDIA_ITEMS.length <= 1) return;
    let nextIndex = currentModalIndex + direction;
    if (nextIndex < 0) nextIndex = window.PRODUCT_MEDIA_ITEMS.length - 1;
    if (nextIndex >= window.PRODUCT_MEDIA_ITEMS.length) nextIndex = 0;
    
    currentModalIndex = nextIndex;
    const modalImg = document.getElementById('zoomModalImg');
    if (modalImg) {
      modalImg.src = window.PRODUCT_MEDIA_ITEMS[currentModalIndex];
    }
    resetModalTransform();
    updateModalCounter();
    goToProductSlide(currentModalIndex);
  }

  // Slide to Specific Image Index on Page
  function goToProductSlide(index) {
    const track = document.getElementById('productSliderTrack');
    if (!track) return;
    const slides = track.querySelectorAll('.product-slide');
    if (index < 0 || index >= slides.length) return;
    
    const targetSlide = slides[index];
    if (targetSlide) {
      track.scrollTo({
        left: targetSlide.offsetLeft,
        behavior: 'smooth'
      });
    }
    updateActiveThumbnail(index);
  }

  // Next / Previous Image Arrow Navigation
  function slideProductGallery(direction) {
    const track = document.getElementById('productSliderTrack');
    if (!track) return;
    const slideWidth = track.offsetWidth || 1;
    const currentIndex = Math.round(track.scrollLeft / slideWidth);
    const slides = track.querySelectorAll('.product-slide');
    let nextIndex = currentIndex + direction;
    if (nextIndex < 0) nextIndex = 0;
    if (nextIndex >= slides.length) nextIndex = slides.length - 1;
    goToProductSlide(nextIndex);
  }

  // Update Thumbnail Active Highlight & Badge Counter
  function updateActiveThumbnail(index) {
    const thumbs = document.querySelectorAll('#galleryThumbsRow .thumb-img');
    thumbs.forEach((t, i) => {
      if (i === index) {
        t.classList.add('active');
        t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      } else {
        t.classList.remove('active');
      }
    });
    const counterEl = document.getElementById('currentSlideNum');
    if (counterEl) {
      counterEl.textContent = (index + 1);
    }
  }

  // Setup Touch Listeners for Pinch-to-Zoom & Pan
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('productSliderTrack');
    if (track) {
      let scrollTimer;
      track.addEventListener('scroll', () => {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          const slideWidth = track.offsetWidth || 1;
          const index = Math.round(track.scrollLeft / slideWidth);
          updateActiveThumbnail(index);
        }, 60);
      }, { passive: true });

      // Touch gesture support (swipe left/right) on slider
      let touchStartX = 0;
      let touchEndX = 0;
      let isSwiping = false;

      track.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          touchStartX = e.touches[0].screenX;
          isSwiping = true;
        }
      }, { passive: true });

      track.addEventListener('touchend', (e) => {
        if (!isSwiping || !e.changedTouches[0]) return;
        touchEndX = e.changedTouches[0].screenX;
        const diffX = touchStartX - touchEndX;
        if (Math.abs(diffX) > 40) {
          if (diffX > 0) {
            slideProductGallery(1);
          } else {
            slideProductGallery(-1);
          }
        }
        isSwiping = false;
      }, { passive: true });
    }

    // Modal Pinch & Pan Touch Listeners
    const modalViewport = document.getElementById('zoomModalViewport');
    const modalImg = document.getElementById('zoomModalImg');

    if (modalViewport && modalImg) {
      let initDist = 0;
      let startScale = 1;
      let startPanX = 0;
      let startPanY = 0;
      let startTouchX = 0;
      let startTouchY = 0;
      let lastTapTime = 0;

      modalViewport.addEventListener('touchstart', (e) => {
        if (e.touches.length === 2) {
          // Pinch start
          initDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          startScale = modalScale;
        } else if (e.touches.length === 1) {
          const now = Date.now();
          const timeSinceLastTap = now - lastTapTime;
          lastTapTime = now;

          // Double tap zoom toggle
          if (timeSinceLastTap < 300) {
            if (modalScale > 1.2) {
              resetModalTransform();
            } else {
              modalScale = 2.5;
              modalPanX = 0;
              modalPanY = 0;
              modalImg.style.transform = `translate3d(0px, 0px, 0px) scale(${modalScale})`;
            }
            return;
          }

          startTouchX = e.touches[0].clientX;
          startTouchY = e.touches[0].clientY;
          startPanX = modalPanX;
          startPanY = modalPanY;
        }
      }, { passive: false });

      modalViewport.addEventListener('touchmove', (e) => {
        if (e.touches.length === 2) {
          e.preventDefault();
          const newDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          if (initDist > 0) {
            modalScale = Math.min(Math.max(1, startScale * (newDist / initDist)), 4);
            modalImg.style.transform = `translate3d(${modalPanX}px, ${modalPanY}px, 0px) scale(${modalScale})`;
          }
        } else if (e.touches.length === 1 && modalScale > 1) {
          e.preventDefault();
          const deltaX = e.touches[0].clientX - startTouchX;
          const deltaY = e.touches[0].clientY - startTouchY;
          modalPanX = startPanX + deltaX;
          modalPanY = startPanY + deltaY;
          modalImg.style.transform = `translate3d(${modalPanX}px, ${modalPanY}px, 0px) scale(${modalScale})`;
        }
      }, { passive: false });

      modalViewport.addEventListener('touchend', (e) => {
        if (modalScale < 1.08) {
          resetModalTransform();
        }
        if (e.touches.length === 0 && modalScale === 1 && startTouchX) {
          const endX = (e.changedTouches[0] && e.changedTouches[0].clientX) || startTouchX;
          const diffX = startTouchX - endX;
          if (Math.abs(diffX) > 50) {
            if (diffX > 0) {
              slideModalZoom(1);
            } else {
              slideModalZoom(-1);
            }
          }
        }
      }, { passive: true });
    }
  });

  // Size Selector Toggle
  function updateSelectedSizePill(radioInput) {
    document.querySelectorAll('.pehrin-size-pills .pehrin-size-pill').forEach(p => p.classList.remove('selected'));
    const span = radioInput.nextElementSibling;
    if (span) span.classList.add('selected');
  }

  // Quantity Stepper
  function adjustProductQty(delta) {
    const qtyInput = document.getElementById('productQtyInput');
    const qtyDisplay = document.getElementById('productQtyDisplay');
    let val = parseInt(qtyInput.value, 10) || 1;
    val += delta;
    if (val < 1) val = 1;
    qtyInput.value = val;
    qtyDisplay.textContent = val;
  }

  // Share Product Link
  function shareCurrentProduct(title, url) {
    if (navigator.share) {
      navigator.share({
        title: title,
        url: url
      }).catch(() => {});
    } else {
      navigator.clipboard.writeText(url).then(() => {
        alert('Product link copied to clipboard! 📋');
      });
    }
  }
</script>

{% schema %}
{
  "name": "Product Details"
}
{% endschema %}
