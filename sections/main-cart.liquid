<div class="section-wrapper" style="max-width: 960px; margin: 0 auto; padding: 48px 20px;">
  <div class="section-header-center">
    <span class="section-subtitle">YOUR SHOPPING BAG</span>
    <h1 class="section-title">Shopping Cart ({% if cart.item_count > 0 %}{{ cart.item_count }} items{% else %}Empty{% endif %})</h1>
  </div>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-page-form">
      <div style="display: flex; flex-direction: column; gap: 20px; border-bottom: 1px solid var(--border-light); padding-bottom: 24px;">
        {%- for item in cart.items -%}
          <div style="display: grid; grid-template-columns: 100px 1fr auto; gap: 20px; align-items: center; background: #ffffff; padding: 16px; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); border: 1px solid var(--border-light);">
            <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" style="width: 100px; height: 130px; object-fit: cover; border-radius: var(--radius-xs);">
            
            <div style="display: flex; flex-direction: column; gap: 6px;">
              <h3 style="font-family: var(--font-heading); font-size: 1.15rem; color: var(--color-primary); margin: 0;">{{ item.product.title }}</h3>
              <div style="font-size: 0.85rem; color: var(--color-text-muted);">Size: <strong>{{ item.variant.title }}</strong></div>
              <div style="font-size: 1.05rem; font-weight: 700; color: var(--color-primary);">{{ item.final_price | money }}</div>
              
              <div style="display: flex; align-items: center; gap: 12px; margin-top: 6px;">
                <label style="font-size: 0.82rem; font-weight: 600;">Qty:</label>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="1" style="width: 60px; padding: 6px; border-radius: var(--radius-xs); border: 1px solid var(--border-medium); text-align: center;">
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="color: #c93b3b; font-size: 0.82rem; text-decoration: underline; margin-left: 10px;">Remove</a>
              </div>
            </div>

            <div style="text-align: right; font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--color-primary);">
              {{ item.final_line_price | money }}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 28px; flex-wrap: wrap; gap: 20px;">
        <div>
          <button type="submit" name="update" class="filter-tab-btn">Update Quantities</button>
        </div>

        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 12px;">
          <div style="display: flex; gap: 16px; font-size: 1.3rem; font-weight: 700; color: var(--color-primary); font-family: var(--font-heading);">
            <span>Subtotal:</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p style="font-size: 0.85rem; color: var(--color-text-muted);">Taxes and shipping calculated at checkout.</p>
          
          <button type="submit" name="checkout" class="btn-primary" style="padding: 16px 40px; font-size: 1rem; width: 100%; max-width: 340px;">
            PROCEED TO CHECKOUT
          </button>
        </div>
      </div>
    </form>
  {%- else -%}
    <div style="text-align: center; padding: 64px 20px; background: var(--color-bg-secondary); border-radius: var(--radius-lg); margin-top: 20px;">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-gold)" stroke-width="1.5" style="margin: 0 auto 16px;">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <h3 style="font-family: var(--font-heading); font-size: 1.6rem; color: var(--color-primary); margin-bottom: 8px;">Your Bag is Currently Empty</h3>
      <p style="color: var(--color-text-muted); margin-bottom: 24px;">Discover our breathable pure cotton silhouettes.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-primary">Explore Collections</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart Page"
}
{% endschema %}
