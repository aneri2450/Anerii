<section class="section-wrapper contact-page-section">
  <div class="contact-page-container">
    
    <!-- Header -->
    <div class="section-header-center">
      <span class="section-subtitle">{{ section.settings.subtitle | default: 'JAIPUR ATELIER & CLIENT CONCIERGE' }}</span>
      <h1 class="section-title">{{ page.title | default: section.settings.title | default: 'Contact Us' }}</h1>
      <p class="section-desc">
        {{ section.settings.description | default: 'Have questions about fits, bespoke sizing, order tracking, or bridal styling? Our Jaipur atelier concierge is here to assist you.' }}
      </p>
    </div>

    <!-- Optional Page Content from Shopify Admin -->
    {%- if page.content != blank -%}
      <div class="page-content rte" style="max-width:800px; margin: 0 auto 36px; text-align: center; color: var(--color-text-muted); line-height: 1.6;">
        {{ page.content }}
      </div>
    {%- endif -%}

    <!-- Contact Info Cards Grid -->
    <div class="contact-cards-grid" style="max-width: 960px; margin: 0 auto 40px;">
      <div class="contact-info-card">
        <span class="contact-icon">📱</span>
        <div>
          <strong>WhatsApp & Call</strong>
          <p><a href="tel:+916376829301">+91 6376829301</a></p>
          <small style="color:var(--color-text-muted); display:block; margin-top:2px;">(Mon–Sat, 10:00 AM – 7:00 PM IST)</small>
        </div>
      </div>

      <div class="contact-info-card">
        <span class="contact-icon">✉️</span>
        <div>
          <strong>Email Support</strong>
          <p><a href="mailto:aneri2450@gmail.com">aneri2450@gmail.com</a></p>
          <small style="color:var(--color-text-muted); display:block; margin-top:2px;">Guaranteed reply within 4 hours</small>
        </div>
      </div>

      <div class="contact-info-card">
        <span class="contact-icon">📍</span>
        <div>
          <strong>Design Studio</strong>
          <p>Anerii Couture Studio, Jaipur, Rajasthan 302020</p>
          <small style="color:var(--color-text-muted); display:block; margin-top:2px;">Handcrafted in Rajasthan, India</small>
        </div>
      </div>

      <div class="contact-info-card">
        <span class="contact-icon">💬</span>
        <div>
          <strong>Instant Concierge</strong>
          <p>
            <a href="https://wa.me/916376829301?text=Hi%20Anerii%20Team,%20I%20have%20an%20inquiry" target="_blank" rel="noopener" class="btn-primary" style="display:inline-block; padding:7px 16px; font-size:0.8rem; margin-top:6px; text-decoration:none;">
              Chat on WhatsApp ↗
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Contact Form Box -->
    <div class="contact-form-wrapper" style="max-width: 680px; margin: 0 auto; background: var(--color-bg-secondary); padding: 36px 28px; border-radius: var(--radius-lg); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm);">
      <h3 style="font-family: var(--font-heading); font-size: 1.5rem; text-align: center; margin-bottom: 8px; color: var(--color-primary);">Send us a Message</h3>
      <p style="font-size: 0.88rem; color: var(--color-text-muted); text-align: center; margin-bottom: 24px;">Fill in your details below and we will get back to you promptly.</p>

      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <div style="background: rgba(39,174,96,0.12); border: 1px solid #27ae60; color: #1e8449; padding: 14px 18px; border-radius: var(--radius-md); margin-bottom: 20px; font-weight: 500; text-align:center;">
            ✓ Thank you for contacting Anerii! Your message has been received. Our team will get back to you shortly.
          </div>
        {%- elsif form.errors -%}
          <div style="background: rgba(231,76,60,0.12); border: 1px solid #e74c3c; color: #c0392b; padding: 14px 18px; border-radius: var(--radius-md); margin-bottom: 20px; font-size: 0.88rem;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
          <div>
            <label for="ContactForm-name" style="display:block; font-size:0.82rem; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:6px; color:var(--color-primary);">Your Name *</label>
            <input type="text" id="ContactForm-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="e.g. Priya Sharma" required style="width:100%; padding:12px 14px; border:1px solid var(--border-light); border-radius:var(--radius-sm); font-family:inherit; font-size:0.9rem; background:#fff;">
          </div>
          <div>
            <label for="ContactForm-email" style="display:block; font-size:0.82rem; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:6px; color:var(--color-primary);">Email Address *</label>
            <input type="email" id="ContactForm-email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="e.g. priya@example.com" required style="width:100%; padding:12px 14px; border:1px solid var(--border-light); border-radius:var(--radius-sm); font-family:inherit; font-size:0.9rem; background:#fff;">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
          <div>
            <label for="ContactForm-phone" style="display:block; font-size:0.82rem; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:6px; color:var(--color-primary);">Phone / WhatsApp</label>
            <input type="tel" id="ContactForm-phone" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="+91 98765 43210" style="width:100%; padding:12px 14px; border:1px solid var(--border-light); border-radius:var(--radius-sm); font-family:inherit; font-size:0.9rem; background:#fff;">
          </div>
          <div>
            <label for="ContactForm-order" style="display:block; font-size:0.82rem; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:6px; color:var(--color-primary);">Order Number (if any)</label>
            <input type="text" id="ContactForm-order" name="contact[order_number]" placeholder="e.g. #ANERII-1024" style="width:100%; padding:12px 14px; border:1px solid var(--border-light); border-radius:var(--radius-sm); font-family:inherit; font-size:0.9rem; background:#fff;">
          </div>
        </div>

        <div style="margin-bottom: 22px;">
          <label for="ContactForm-body" style="display:block; font-size:0.82rem; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:6px; color:var(--color-primary);">Message / Query *</label>
          <textarea id="ContactForm-body" name="contact[body]" rows="5" placeholder="How can we assist you today? Mention sizes, fabrics, delivery queries, etc." required style="width:100%; padding:12px 14px; border:1px solid var(--border-light); border-radius:var(--radius-sm); font-family:inherit; font-size:0.9rem; background:#fff; resize:vertical;">{{ form.body }}</textarea>
        </div>

        <button type="submit" class="btn-primary" style="width: 100%; padding: 14px; font-size: 0.92rem; letter-spacing: 0.08em; text-transform: uppercase;">
          SEND MESSAGE
        </button>
      {%- endform -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "JAIPUR ATELIER & CLIENT CONCIERGE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Have questions about fits, bespoke sizing, order tracking, or bridal styling? Our Jaipur atelier concierge is here to assist you."
    }
  ],
  "presets": [
    {
      "name": "Contact Page"
    }
  ]
}
{% endschema %}
