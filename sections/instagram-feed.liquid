{% schema %}
{
  "name": "Instagram Feed",
  "settings": [
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram Handle",
      "default": "aneri_officials"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Profile Link"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Photo"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location Tag",
          "default": "Jaipur, Rajasthan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed"
    }
  ]
}
{% endschema %}
