<section class="section-wrapper" id="collections">
  <div class="section-header-center">
    <span class="section-subtitle">{{ section.settings.subtitle | default: 'PRÊT-À-PORTER 2026' }}</span>
    <h2 class="section-title">{{ section.settings.title | default: 'Latest Collections' }}</h2>
    <p class="section-desc">{{ section.settings.description | default: 'Pure 60×60 breathable cotton silhouettes designed for timeless elegance.' }}</p>
  </div>

  <!-- Category Filter Tabs with Mobile Smooth Horizontal Scroll -->
  <div class="filter-tabs-wrapper">
    <div class="filter-tabs">
      <button type="button" class="filter-tab-btn active" data-filter="all" onclick="if(typeof filterCategory==='function') filterCategory('all')">All Designs</button>
      <button type="button" class="filter-tab-btn" data-filter="co-ords" onclick="if(typeof filterCategory==='function') filterCategory('co-ords')">Co-ord Sets</button>
      <button type="button" class="filter-tab-btn" data-filter="kurta-sets" onclick="if(typeof filterCategory==='function') filterCategory('kurta-sets')">Kurta Sets</button>
      <button type="button" class="filter-tab-btn" data-filter="kurtis" onclick="if(typeof filterCategory==='function') filterCategory('kurtis')">Kurtis & Tops</button>
      <button type="button" class="filter-tab-btn" data-filter="noor-e-neel" onclick="if(typeof filterCategory==='function') filterCategory('noor-e-neel')">Noor-e-Neel (Sky Blue)</button>
      <button type="button" class="filter-tab-btn" data-filter="rangrez" onclick="if(typeof filterCategory==='function') filterCategory('rangrez')">Rangrez (Rani Pink)</button>
      <button type="button" class="filter-tab-btn" data-filter="gulnaaz" onclick="if(typeof filterCategory==='function') filterCategory('gulnaaz')">Gulnaaz (Floral)</button>
    </div>
  </div>

  <div class="products-grid">
    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product_card_product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for product in collections.all.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product_card_product: product %}
      {%- else -%}
        <div style="grid-column: 1 / -1; text-align: center; padding: 40px;">
          <p>No products found in this collection. Add products in Shopify Admin > Products.</p>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "PRÊT-À-PORTER 2026"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Latest Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Pure 60×60 breathable cotton silhouettes designed for timeless elegance."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
