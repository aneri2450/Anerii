<section id="lookbook" class="lookbook-section">
  <!-- River Wave Motion Divider (Top: Collections White to Lookbook Dark) -->
  <div class="river-wave-divider river-wave-top" aria-hidden="true">
    <div class="river-wave-strip">
      <svg class="river-wave-svg wave-back" viewBox="0 0 2880 100" preserveAspectRatio="none">
        <path d="M 0,58 C 280,22 560,18 840,42 C 1020,58 1160,94 1440,58 C 1720,22 2000,18 2280,42 C 2460,58 2600,94 2880,58 L 2880,120 L 0,120 Z"></path>
      </svg>
      <svg class="river-wave-svg wave-mid" viewBox="0 0 2880 100" preserveAspectRatio="none">
        <path d="M 0,40 C 120,70 220,74 300,52 C 340,38 360,10 480,40 C 600,70 700,74 780,52 C 820,38 840,10 960,40 C 1080,70 1180,74 1260,52 C 1300,38 1320,10 1440,40 C 1560,70 1660,74 1740,52 C 1780,38 1800,10 1920,40 C 2040,70 2140,74 2220,52 C 2260,38 2280,10 2400,40 C 2520,70 2620,74 2700,52 C 2740,38 2760,10 2880,40 L 2880,120 L 0,120 Z"></path>
      </svg>
      <svg class="river-wave-svg wave-front" viewBox="0 0 2880 100" preserveAspectRatio="none">
        <path d="M 0,48 C 150,23 270,16 380,24 C 520,34 600,76 720,76 C 850,76 950,28 1070,24 C 1180,20 1290,73 1440,48 C 1590,23 1710,16 1820,24 C 1960,34 2040,76 2160,76 C 2290,76 2390,28 2510,24 C 2620,20 2730,73 2880,48 L 2880,120 L 0,120 Z"></path>
      </svg>
    </div>
  </div>

  <div class="lookbook-content-wrap">
  <div class="section-header-center">
    <span class="section-subtitle" style="color: var(--color-accent-gold-light);">{{ section.settings.subtitle | default: '#AneriiAesthetics' }}</span>
    <h2 class="section-title" style="color: #ffffff;">{{ section.settings.title | default: 'Anerii • Video Lookbook' }}</h2>
    <p class="section-desc" style="color: rgba(247, 246, 242, 0.75);">{{ section.settings.desc | default: 'Watch our pure cotton silhouettes in motion. Click any reel to play with audio.' }}</p>
  </div>

  <div class="reels-carousel-wrapper">
    <!-- Desktop Navigation Arrows -->
    <button class="reels-nav-btn prev" id="reelsPrevBtn" aria-label="Previous Reels" onclick="scrollReelsTrack(-1)">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    
    <button class="reels-nav-btn next" id="reelsNextBtn" aria-label="Next Reels" onclick="scrollReelsTrack(1)">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <div class="reels-track" id="shopifyReelsTrack">
      
      {%- assign default_videos = "https://cdn.shopify.com/videos/c/o/v/b7a5e4f4e3994a36959c177d9875a128.mp4,https://cdn.shopify.com/videos/c/o/v/b7a7c846c92944cf99ac3d5534ab4ae3.mp4,https://cdn.shopify.com/videos/c/o/v/ef83a752220c43529ce72f09e021e22f.mp4,https://cdn.shopify.com/videos/c/o/v/19238211044f4528bfd41bf9fdf9f9e2.mp4,https://cdn.shopify.com/videos/c/o/v/d7005fa345ed499582b89d119f4a6fad.mp4,https://cdn.shopify.com/videos/c/o/v/a0a41e817998420b95df10df3cc377b0.mp4,https://cdn.shopify.com/videos/c/o/v/bd6d6c8d204045798f9683e172787566.mp4,https://cdn.shopify.com/videos/c/o/v/1e87a0c24f944af7b20508ece88763e8.mp4,https://cdn.shopify.com/videos/c/o/v/5a700642340a40e59eda755f75dcae4e.mp4" | split: "," -%}
      {%- assign default_titles = "Rangrez Kurta Set,Rangrez Co-ord Set,Rangrez Short Top,Gulnaaz Kurta Set,Gulnaaz Co-ord Set,Gulnaaz Short Kurti,Noor-e-Neel Kurta Set,Noor-e-Neel Cord Set,Noor-e-Neel Backless Short Kurti" | split: "," -%}
      {%- assign default_subs = "Summer Prêt 2026,Summer Prêt 2026,Summer Prêt 2026,Summer Prêt 2026,Summer Prêt 2026,Summer Prêt 2026,Summer Prêt 2026,Summer Prêt 2026,Summer Prêt 2026" | split: "," -%}
      {%- assign default_links = "/products/rani-printed-kurta-set,/products/rani-printed-cord-set,/products/coral-pink-v-neck-top,/products/gulnaaz-kurta-set,/products/gulnaaz-cord-set,/products/gulnaaz-short-kurti,/products/noor-e-neel-kurta-set,/products/noor-e-neel-cord-set,/products/noor-e-neel-backless-short-kurti" | split: "," -%}

      {%- for i in (0..8) -%}
        {%- assign block = section.blocks[i] -%}
        <div class="reel-card" onclick="handleReelClick(this)">
          
          {%- if block.settings.video_url != blank -%}
            <video class="reel-video" data-src="{{ block.settings.video_url }}" loop muted playsinline preload="none"></video>
          {%- else -%}
            <video class="reel-video" data-src="{{ default_videos[i] }}" loop muted playsinline preload="none"></video>
          {%- endif -%}
          
          <div class="reel-overlay">
            <div class="reel-top-bar">
              <span class="reel-sound-badge" title="Click to toggle sound">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sound-icon-svg">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <line x1="23" y1="9" x2="17" y2="15"></line>
                  <line x1="17" y1="9" x2="23" y2="15"></line>
                </svg>
                <span class="sound-text">Sound Off</span>
              </span>
              <span class="reel-quality-pill">Pure 60×60</span>
            </div>
            <div class="reel-center-play">
              <div class="reel-play-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </div>
            </div>
            <div class="reel-bottom-info">
              <span class="reel-collection">{% if block.settings.subtitle != blank %}{{ block.settings.subtitle }}{% else %}{{ default_subs[i] }}{% endif %}</span>
              <span class="reel-title">{% if block.settings.title != blank %}{{ block.settings.title }}{% else %}{{ default_titles[i] }}{% endif %}</span>
              <a href="{% if block.settings.product_link != blank %}{{ block.settings.product_link }}{% else %}{{ default_links[i] }}{% endif %}" class="reel-shop-btn" onclick="event.stopPropagation()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span>Shop This Look</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-svg">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      {%- endfor -%}

    </div>
  </div>
  </div>

  <!-- River Wave Motion Divider (Bottom: Lookbook Dark to Reviews White) -->
  <div class="river-wave-divider river-wave-bottom" aria-hidden="true">
    <div class="river-wave-strip">
      <svg class="river-wave-svg wave-back" viewBox="0 0 2880 100" preserveAspectRatio="none">
        <path d="M 0,58 C 280,22 560,18 840,42 C 1020,58 1160,94 1440,58 C 1720,22 2000,18 2280,42 C 2460,58 2600,94 2880,58 L 2880,120 L 0,120 Z"></path>
      </svg>
      <svg class="river-wave-svg wave-mid" viewBox="0 0 2880 100" preserveAspectRatio="none">
        <path d="M 0,40 C 120,70 220,74 300,52 C 340,38 360,10 480,40 C 600,70 700,74 780,52 C 820,38 840,10 960,40 C 1080,70 1180,74 1260,52 C 1300,38 1320,10 1440,40 C 1560,70 1660,74 1740,52 C 1780,38 1800,10 1920,40 C 2040,70 2140,74 2220,52 C 2260,38 2280,10 2400,40 C 2520,70 2620,74 2700,52 C 2740,38 2760,10 2880,40 L 2880,120 L 0,120 Z"></path>
      </svg>
      <svg class="river-wave-svg wave-front" viewBox="0 0 2880 100" preserveAspectRatio="none">
        <path d="M 0,48 C 150,23 270,16 380,24 C 520,34 600,76 720,76 C 850,76 950,28 1070,24 C 1180,20 1290,73 1440,48 C 1590,23 1710,16 1820,24 C 1960,34 2040,76 2160,76 C 2290,76 2390,28 2510,24 C 2620,20 2730,73 2880,48 L 2880,120 L 0,120 Z"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  /* Lookbook Section & Content Spacing with Wave Dividers */
  .lookbook-section {
    padding: 0 !important;
    position: relative;
    overflow: hidden;
    background-color: var(--color-primary-dark, #1c231a);
  }

  .lookbook-content-wrap {
    padding: 56px 0 60px;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .lookbook-content-wrap {
      padding: 38px 0 42px;
    }
  }

  /* River Wave Motion Dividers ("Nadi Lahar" Flow Effect) */
  .river-wave-divider {
    position: relative;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
    pointer-events: none;
    user-select: none;
  }

  .river-wave-divider.river-wave-top {
    background: var(--color-bg-main, #ffffff);
    margin-top: 0;
    margin-bottom: -1px;
  }

  .river-wave-divider.river-wave-bottom {
    background: var(--color-primary-dark, #1c231a);
    margin-top: -1px;
    margin-bottom: 0;
  }

  .river-wave-strip {
    position: relative;
    width: 200%;
    height: 64px;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .river-wave-strip {
      height: 44px;
    }
  }

  .river-wave-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    will-change: transform;
    transform-origin: bottom center;
  }

  /* Top Wave: White to #1c231a */
  .river-wave-top .river-wave-svg.wave-back {
    fill: rgba(28, 35, 26, 0.28);
    animation: riverWaveFlowBack 18s linear infinite;
  }

  .river-wave-top .river-wave-svg.wave-mid {
    fill: rgba(225, 207, 185, 0.55);
    animation: riverWaveFlowMid 13s linear infinite;
  }

  .river-wave-top .river-wave-svg.wave-front {
    fill: var(--color-primary-dark, #1c231a);
    animation: riverWaveFlowFront 8.5s linear infinite;
  }

  /* Bottom Wave: #1c231a to White */
  .river-wave-bottom .river-wave-svg.wave-back {
    fill: rgba(225, 207, 185, 0.35);
    animation: riverWaveFlowBack 18s linear infinite;
  }

  .river-wave-bottom .river-wave-svg.wave-mid {
    fill: rgba(255, 255, 255, 0.65);
    animation: riverWaveFlowMid 13s linear infinite;
  }

  .river-wave-bottom .river-wave-svg.wave-front {
    fill: var(--color-bg-main, #ffffff);
    animation: riverWaveFlowFront 8.5s linear infinite;
  }

  @keyframes riverWaveFlowFront {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes riverWaveFlowMid {
    0% {
      transform: translate3d(0, 0, 0) scaleY(1);
    }
    50% {
      transform: translate3d(-25%, 0, 0) scaleY(1.08);
    }
    100% {
      transform: translate3d(-50%, 0, 0) scaleY(1);
    }
  }

  @keyframes riverWaveFlowBack {
    0% {
      transform: translate3d(0, 0, 0) scaleY(1);
    }
    50% {
      transform: translate3d(-25%, 0, 0) scaleY(0.92);
    }
    100% {
      transform: translate3d(-50%, 0, 0) scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .river-wave-svg {
      animation: none !important;
    }
  }
  .reel-card {
    flex: 0 0 250px;
    height: 420px;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    background-color: #141b13;
    cursor: pointer;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.35s ease;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(225, 207, 185, 0.28);
  }

  .reel-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.6), 0 0 24px rgba(225, 207, 185, 0.35);
    border-color: rgba(225, 207, 185, 0.65);
  }

  .reel-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: transform 0.5s ease;
  }

  .reel-card:hover .reel-video {
    transform: scale(1.03);
  }

  .reel-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(14, 20, 13, 0.5) 0%,
      rgba(14, 20, 13, 0.05) 25%,
      rgba(14, 20, 13, 0.2) 55%,
      rgba(14, 20, 13, 0.94) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
    z-index: 2;
    transition: background 0.3s ease;
  }

  .reel-card:hover .reel-overlay {
    background: linear-gradient(
      180deg,
      rgba(14, 20, 13, 0.6) 0%,
      rgba(14, 20, 13, 0.1) 25%,
      rgba(14, 20, 13, 0.28) 50%,
      rgba(14, 20, 13, 0.97) 100%
    );
  }

  .reel-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .reel-sound-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(20, 27, 19, 0.8);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(225, 207, 185, 0.35);
    color: #E1CFB9;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 5px 11px;
    border-radius: 20px;
    transition: all 0.25s ease;
  }

  .reel-sound-badge.active {
    background: rgba(225, 207, 185, 0.95);
    color: #141b13;
    border-color: #E1CFB9;
    box-shadow: 0 0 12px rgba(225, 207, 185, 0.5);
  }

  .reel-quality-pill {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 4px 9px;
    border-radius: 12px;
  }

  .reel-center-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }

  .reel-play-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(20, 27, 19, 0.82);
    border: 1.5px solid #E1CFB9;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), 0 0 16px rgba(225, 207, 185, 0.4);
    color: #E1CFB9;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 3px;
  }

  .reel-card:hover .reel-center-play {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .reel-bottom-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .reel-collection {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    color: #E1CFB9;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .reel-title {
    font-family: var(--font-heading, "Cormorant Garamond", Georgia, serif);
    font-size: 1.18rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.25;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .reel-shop-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    margin-top: 6px;
    background: linear-gradient(135deg, #ffffff 0%, #f7f3ea 100%);
    color: #1c231a;
    border: 1px solid rgba(225, 207, 185, 0.45);
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 10px 14px;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .reel-shop-btn:hover {
    background: linear-gradient(135deg, #E1CFB9 0%, #E1CFB9 100%);
    color: #141b13;
    border-color: #E1CFB9;
    box-shadow: 0 6px 20px rgba(225, 207, 185, 0.5);
    transform: translateY(-2px);
  }

  .reel-shop-btn .arrow-svg {
    transition: transform 0.2s ease;
  }

  .reel-shop-btn:hover .arrow-svg {
    transform: translateX(3px);
  }

  .reels-carousel-wrapper {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 45px;
  }

  .reels-track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(225, 207, 185, 0.4) transparent;
    padding: 12px 6px 24px;
    cursor: grab;
    user-select: none;
  }

  .reels-track.active-drag {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  .reels-track::-webkit-scrollbar {
    height: 6px;
  }

  .reels-track::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
  }

  .reels-track::-webkit-scrollbar-thumb {
    background: rgba(225, 207, 185, 0.4);
    border-radius: 10px;
  }

  .reels-track::-webkit-scrollbar-thumb:hover {
    background: rgba(225, 207, 185, 0.8);
  }

  /* Desktop Navigation Buttons */
  .reels-nav-btn {
    position: absolute;
    top: calc(50% - 12px);
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(20, 27, 19, 0.9);
    border: 1.5px solid rgba(225, 207, 185, 0.5);
    color: #E1CFB9;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.25s ease;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
  }

  .reels-nav-btn:hover {
    background: #E1CFB9;
    color: #141b13;
    border-color: #E1CFB9;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 8px 24px rgba(225, 207, 185, 0.5);
  }

  .reels-nav-btn.prev {
    left: 2px;
  }

  .reels-nav-btn.next {
    right: 2px;
  }

  @media (max-width: 768px) {
    .reels-carousel-wrapper {
      padding: 0 16px;
    }
    .reels-nav-btn {
      display: none;
    }
    .reel-card {
      flex: 0 0 220px;
      height: 380px;
    }
  }
</style>

<script>
  // 1. Navigation Button Scroll
  function scrollReelsTrack(direction) {
    const track = document.getElementById('shopifyReelsTrack');
    if (!track) return;
    const cardWidth = 260; // Card width + gap
    track.scrollBy({
      left: direction * (cardWidth * 2),
      behavior: 'smooth'
    });
  }

  // 2. Reel Click / Audio Toggle Handling
  function handleReelClick(card) {
    const video = card.querySelector('video');
    const badge = card.querySelector('.reel-sound-badge');
    const soundText = card.querySelector('.sound-text');

    if (!video) return;

    // Mute all other videos
    document.querySelectorAll('.lookbook-section video').forEach(v => {
      if (v !== video) {
        v.muted = true;
        const b = v.parentElement?.querySelector('.reel-sound-badge');
        const st = v.parentElement?.querySelector('.sound-text');
        if (b) b.classList.remove('active');
        if (st) st.textContent = 'Sound Off';
      }
    });

    if (video.muted) {
      video.muted = false;
      video.play().then(() => {
        if (badge) badge.classList.add('active');
        if (soundText) soundText.textContent = 'Sound On';
      }).catch(() => {
        video.muted = true;
        video.play();
      });
    } else {
      video.muted = true;
      if (badge) badge.classList.remove('active');
      if (soundText) soundText.textContent = 'Sound Off';
    }
  }

  // 3. Desktop Drag-To-Scroll & Mouse Wheel & Intersection Observer
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('shopifyReelsTrack');
    if (track) {
      // Horizontal scroll on mouse wheel
      track.addEventListener('wheel', (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          e.preventDefault();
          track.scrollLeft += e.deltaY;
        }
      }, { passive: false });

      // Mouse drag to scroll
      let isDown = false;
      let startX;
      let scrollLeft;
      let isDragging = false;

      track.addEventListener('mousedown', (e) => {
        isDown = true;
        isDragging = false;
        track.classList.add('active-drag');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      track.addEventListener('mouseleave', () => {
        isDown = false;
        track.classList.remove('active-drag');
      });

      track.addEventListener('mouseup', () => {
        isDown = false;
        track.classList.remove('active-drag');
      });

      track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5; // Scroll speed multiplier
        if (Math.abs(walk) > 5) isDragging = true;
        track.scrollLeft = scrollLeft - walk;
      });

      // Prevent click action when dragging
      track.querySelectorAll('.reel-card').forEach(card => {
        card.addEventListener('click', (e) => {
          if (isDragging) {
            e.stopPropagation();
            e.preventDefault();
          }
        }, true);
      });
    }

    // 4. Smart Video Lazy Loading & Auto-Pause Observer (Massive Page Speed Optimization)
    if ('IntersectionObserver' in window) {
      const reelObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const video = entry.target.querySelector('video');
          if (!video) return;

          if (entry.isIntersecting) {
            // Lazy load video stream on demand
            if (!video.src && video.dataset.src) {
              video.src = video.dataset.src;
              video.load();
            }
            if (video.paused) {
              video.play().catch(() => {});
            }
          } else {
            // Out of viewport -> Stop video to save CPU and battery
            if (!video.paused) {
              video.pause();
            }
            video.muted = true;
            const badge = entry.target.querySelector('.reel-sound-badge');
            if (badge) badge.textContent = '🔇';
          }
        });
      }, {
        rootMargin: '250px 0px 250px 0px',
        threshold: [0, 0.25]
      });

      document.querySelectorAll('.reel-card').forEach(card => {
        reelObserver.observe(card);
      });

      // Observe the lookbook section
      const lookbookSection = document.getElementById('lookbook');
      if (lookbookSection) {
        const sectionObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) {
              lookbookSection.querySelectorAll('video').forEach(v => {
                if (!v.paused) v.pause();
                v.muted = true;
              });
            }
          });
        }, { threshold: 0 });

        sectionObserver.observe(lookbookSection);
      }
    } else {
      // Fallback: Load directly
      document.querySelectorAll('.reel-video').forEach(v => {
        if (v.dataset.src) v.src = v.dataset.src;
      });
    }
  });
</script>

