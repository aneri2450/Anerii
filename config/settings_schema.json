[
  {
    "name": "theme_info",
    "theme_name": "Anerii Luxury Couture",
    "theme_version": "1.0.0",
    "theme_author": "Anerii",
    "theme_documentation_url": "https://anerii.com",
    "theme_support_url": "https://anerii.com"
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Brand Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Olive Green",
        "default": "#283525"
      },
      {
        "type": "color",
        "id": "color_header_footer",
        "label": "Header & Footer Dark Olive",
        "default": "#1c231a"
      },
      {
        "type": "color",
        "id": "color_accent_gold",
        "label": "Accent Champagne Gold",
        "default": "#c6a25e"
      },
      {
        "type": "color",
        "id": "color_pehrin_maroon",
        "label": "Product Title / Sale Maroon",
        "default": "#5e2c29"
      }
    ]
  },
  {
    "name": "Free Shipping Threshold",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold Amount (INR)",
        "default": 1299
      }
    ]
  },
  {
    "name": "Promotions & Offers",
    "settings": [
      {
        "type": "header",
        "content": "Special Offer Buttons & Popup"
      },
      {
        "type": "checkbox",
        "id": "enable_offer_features",
        "label": "Enable Special Offer Features",
        "info": "Master switch to turn ON/OFF the Special Offer popup, floating offer pill, and mobile bottom bar offer tab across the entire store.",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_floating_offer_pill",
        "label": "Show Floating 'Special Offer' Pill",
        "info": "Floating pill at bottom-left corner with gift icon and discount badge",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_bottom_nav_offer",
        "label": "Show 'Offer' Tab in Mobile Bottom Bar",
        "info": "Center circular Offer button in mobile bottom navigation bar",
        "default": false
      }
    ]
  }
]

