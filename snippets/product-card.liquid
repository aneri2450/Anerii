{%- comment -%}
  Pehrin-Inspired Organic Arch Product Card Snippet
  Usage: {% render 'product-card', product_card_product: product %}
{%- endcomment -%}

{%- assign title_l = product_card_product.title | downcase -%}
{%- assign handle_l = product_card_product.handle | downcase -%}
{%- assign type_l = product_card_product.type | downcase -%}
{%- assign tags_l = product_card_product.tags | join: ' ' | downcase -%}
{%- assign combined_meta = title_l | append: ' ' | append: handle_l | append: ' ' | append: type_l | append: ' ' | append: tags_l -%}

{%- assign p_cat = '' -%}
{%- if combined_meta contains 'cord' or combined_meta contains 'co-ord' -%}
  {%- assign p_cat = 'co-ords' -%}
{%- elsif combined_meta contains 'kurta set' or (combined_meta contains 'kurta' and combined_meta contains 'set') -%}
  {%- assign p_cat = 'kurta-sets' -%}
{%- elsif combined_meta contains 'kurti' or combined_meta contains 'top' or combined_meta contains 'short' or combined_meta contains 'coral' -%}
  {%- assign p_cat = 'kurtis' -%}
{%- elsif combined_meta contains 'kurta' -%}
  {%- assign p_cat = 'kurta-sets' -%}
{%- endif -%}

{%- assign p_coll = '' -%}
{%- if combined_meta contains 'gulnaaz' -%}
  {%- assign p_coll = 'gulnaaz' -%}
{%- elsif combined_meta contains 'noor-e-neel' or combined_meta contains 'noor' -%}
  {%- assign p_coll = 'noor-e-neel' -%}
{%- elsif combined_meta contains 'rangrez' or combined_meta contains 'rani' or combined_meta contains 'coral' -%}
  {%- assign p_coll = 'rangrez' -%}
{%- endif -%}

{%- for c in product_card_product.collections -%}
  {%- assign c_title = c.title | downcase -%}
  {%- if c_title contains 'rangrez' or c_title contains 'rani' or c_title contains 'coral' -%}{%- assign p_coll = 'rangrez' -%}{%- endif -%}
  {%- if c_title contains 'gulnaaz' -%}{%- assign p_coll = 'gulnaaz' -%}{%- endif -%}
  {%- if c_title contains 'noor' -%}{%- assign p_coll = 'noor-e-neel' -%}{%- endif -%}
  {%- if c_title contains 'kurti' or c_title contains 'top' -%}{%- assign p_cat = 'kurtis' -%}{%- endif -%}
  {%- if c_title contains 'co-ord' or c_title contains 'cord' -%}{%- assign p_cat = 'co-ords' -%}{%- endif -%}
  {%- if c_title contains 'kurta' -%}{%- assign p_cat = 'kurta-sets' -%}{%- endif -%}
{%- endfor -%}

<div class="product-card-wrap" data-category="{{ p_cat }}" data-collection="{{ p_coll }}" data-handle="{{ product_card_product.handle }}" data-tags="{{ tags_l }}">
  <div class="product-card" onclick="window.location.href='{{ product_card_product.url }}'">
    
    {%- if product_card_product.compare_at_price > product_card_product.price -%}
      <span class="product-sale-pill">Sale</span>
    {%- endif -%}

    <button class="product-wishlist-btn" 
            onclick="event.stopPropagation(); this.classList.toggle('active');" 
            title="Wishlist" aria-label="Wishlist">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>

    <div class="product-media-wrap">
      {%- if product_card_product.featured_media != blank -%}
        <img class="product-img-primary" 
             src="{{ product_card_product.featured_media | image_url: width: 500 }}" 
             srcset="{{ product_card_product.featured_media | image_url: width: 360 }} 360w, {{ product_card_product.featured_media | image_url: width: 500 }} 500w, {{ product_card_product.featured_media | image_url: width: 720 }} 720w"
             sizes="(max-width: 600px) 48vw, (max-width: 1024px) 32vw, 24vw"
             alt="{{ product_card_product.title | escape }}" 
             loading="lazy" 
             decoding="async"
             width="400" 
             height="500">
        {%- if product_card_product.media[1] != blank -%}
          <img class="product-img-hover" 
               src="{{ product_card_product.media[1] | image_url: width: 500 }}" 
               srcset="{{ product_card_product.media[1] | image_url: width: 360 }} 360w, {{ product_card_product.media[1] | image_url: width: 500 }} 500w, {{ product_card_product.media[1] | image_url: width: 720 }} 720w"
               sizes="(max-width: 600px) 48vw, (max-width: 1024px) 32vw, 24vw"
               alt="{{ product_card_product.title | escape }}" 
               loading="lazy" 
               decoding="async"
               width="400" 
               height="500">
        {%- endif -%}
      {%- else -%}
        <div style="width:100%; height:100%; background:#e8dfd8; display:flex; align-items:center; justify-content:center;">
          <span style="color:#777;">No Image</span>
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      <h3 class="product-title">{{ product_card_product.title }}</h3>
      
      <div class="product-pricing">
        {%- if product_card_product.compare_at_price > product_card_product.price -%}
          <span class="price-original">{{ product_card_product.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="price-current">{{ product_card_product.price | money }}</span>
      </div>

      <div class="product-card-btn-row" onclick="event.stopPropagation();">
        <a href="{{ product_card_product.url }}" class="card-btn-add">
          ADD TO CART
        </a>
        <form method="post" action="/cart/add" style="flex:1;">
          <input type="hidden" name="id" value="{{ product_card_product.variants.first.id }}" />
          <input type="hidden" name="return_to" value="/checkout" />
          <button type="submit" class="card-btn-buy" style="width:100%;">
            BUY IT NOW
          </button>
        </form>
      </div>
    </div>

  </div>
</div>
